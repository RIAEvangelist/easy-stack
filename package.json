{
  "name": "easy-stack",
  "version": "2.1.0",
  "description": "Zero-dependency cooperative LIFO execution for Node.js and browsers",
  "type": "module",
  "main": "./stack.js",
  "module": "./stack.js",
  "browser": "./stack.js",
  "exports": {
    ".": {
      "import": "./stack.js",
      "require": "./stack.js",
      "default": "./stack.js"
    },
    "./stack.js": {
      "import": "./stack.js",
      "require": "./stack.js",
      "default": "./stack.js"
    },
    "./stack-vanilla.js": "./stack-vanilla.js",
    "./es5.js": {
      "import": "./stack.js",
      "require": "./stack.js",
      "default": "./es5.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "stack.js",
    "stack-vanilla.js",
    "es5.js",
    "CHANGELOG.md",
    "MIGRATION.md",
    "licence"
  ],
  "sideEffects": [
    "./stack-vanilla.js",
    "./es5.js"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node ./scripts/test.js all",
    "test:unit": "node ./scripts/test.js unit",
    "test:functional": "node ./scripts/test.js functional",
    "test:integration": "node ./scripts/test.js integration",
    "test:regression": "node ./scripts/test.js regression",
    "test:regression:chrome": "node ./scripts/test.js browser",
    "coverage": "vanilla-test coverage",
    "coverage:node": "vanilla-test coverage node",
    "coverage:chrome": "vanilla-test coverage chrome",
    "benchmark": "node --expose-gc ./scripts/benchmark.js",
    "check": "npm test && npm run coverage:node",
    "start": "node ./scripts/serve.js"
  },
  "keywords": [
    "stack",
    "lifo",
    "scheduler",
    "priority",
    "javascript",
    "node",
    "browser",
    "zero-dependency"
  ],
  "author": "Brandon Nozaki Miller",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RIAEvangelist/easy-stack.git"
  },
  "bugs": {
    "url": "https://github.com/RIAEvangelist/easy-stack/issues"
  },
  "homepage": "https://riaevangelist.github.io/easy-stack/",
  "devDependencies": {
    "vanilla-test": "2.1.1"
  }
}
